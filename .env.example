# Copy to .env and adjust.

# Token for `arena admin ...` commands. Required, at least 24 characters.
# Generate one with: openssl rand -hex 32
ARENA_ADMIN_TOKEN=

# Server that `arena login --admin` sends the token to. Leave empty on the host
# to use http://localhost:$ARENA_PORT. Only trust a .env you wrote yourself.
ARENA_SERVER=

# Event code participants type on http://<host>:8080/join to create their own
# account (6+ characters; announce it in the room). Empty disables sign-up, and
# you create every participant with `arena admin user add`.
ARENA_JOIN_CODE=

# Image tag to run (a release version such as 0.1.0, or latest).
ARENA_VERSION=latest

# Host port for the API, WebSocket and projector page.
ARENA_PORT=8080

# CPUs to pin judge sandboxes to, one sandbox per CPU. Use one hardware thread
# per physical core, and on hybrid CPUs only performance cores. Find them with
#   lscpu -e=CPU,CORE,MAXMHZ
# Empty = unpinned (noisier timings).
JUDGE_CPUS=

# Ask GitHub every 6 hours whether a newer release exists (it never installs
# anything). Set to off for no outbound requests.
ARENA_UPDATE_CHECK=on

RUST_LOG=info
