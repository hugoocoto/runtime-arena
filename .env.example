# Runtime Arena settings. Copy to .env, then keep it private:
#   cp .env.example .env && chmod 600 .env
# Apply changes with: docker compose up -d


# ------------------------------------------------------------------------------
# Set these before your first start
# ------------------------------------------------------------------------------

# Required. Password for all `arena admin` commands; anyone who has it controls
# the contest. At least 24 characters. Generate one with:
#   openssl rand -hex 32
ARENA_ADMIN_TOKEN=

# Event code participants need to create an account, on /join or with
# `arena signup`. At least 6 characters; announce it in the room.
# Empty turns sign-up off, and then nobody new can join.
ARENA_JOIN_CODE=

# CPUs for judging, comma-separated, e.g. 0,2,4,6. Each one runs one judge worker.
# For stable timings, use one hardware thread per physical core and, on hybrid
# CPUs, only performance cores. List them with: lscpu -e=CPU,CORE,MAXMHZ
# Empty runs a single unpinned worker, with noisier timings.
JUDGE_CPUS=


# ------------------------------------------------------------------------------
# Optional: the defaults work for most contests
# ------------------------------------------------------------------------------

# --- Judging ---

# Processes and threads one submission may create, so OpenMP, pthreads and
# multi-process programs work. The memory limit and CPU time cover all of them.
# Multi-node MPI is not supported (the sandbox has no network).
ARENA_PROCESSES=64

# Stop judging after this many failing tests. 0 runs every test (slower for
# wrong or too-slow submissions, but the report names every failing test).
ARENA_MAX_FAILURES=3

# Disk each judge box may use, in MiB. Boxes are size-limited tmpfs mounts, so
# this is RAM only while a program actually writes files.
ARENA_DISK_MB=512

# --- Network ---

# Host port for the API, WebSocket and projector page.
# Use 127.0.0.1:8080 to accept connections from this machine only.
ARENA_PORT=8080

# Requests per second allowed from one network address; 0 turns the limit off.
# The default fits about 200 participants sharing one address.
ARENA_RATE_LIMIT=200

# --- Admin CLI ---

# Server that `arena login --admin` sends the admin token to. Leave empty on the
# host to use http://localhost:$ARENA_PORT. Set it only on another machine, and
# only trust a .env you wrote yourself: this address receives your token.
ARENA_SERVER=

# --- Releases ---

# Server image to run: a release such as 0.5.0, or latest.
# Pin a release during an event so a restart can't change the version.
ARENA_VERSION=latest

# Ask GitHub at startup and every 6 hours whether a newer release exists. It only
# notifies you and never installs anything. Use off for no outbound requests.
ARENA_UPDATE_CHECK=on

# --- Logging ---

# Server log detail: error, warn, info, debug or trace.
RUST_LOG=info
